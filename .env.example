# Copy this file to .env (at repo root) and adjust values as needed
# .env should be added to .gitignore — never commit real credentials

MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=solar_panel_automation
MYSQL_USER=admin
MYSQL_PASSWORD=admin

# Used by backend (FastAPI/SQLAlchemy) to connect to MySQL inside Docker Compose
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://admin:admin@db:3306/solar_panel_automation

# Backend individual connection vars (use DB_HOST=db inside Docker Compose)
DB_HOST=db
DB_PORT=3306
DB_NAME=solar_panel_automation
DB_USER=admin
DB_PASSWORD=admin

APP_NAME=Solar Intelligence Platform API
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# Model 1 — Solar Position API (Docker Compose service name)
MODEL1_SERVICE_URL=http://models:8000
MODEL_SERVICE_URL=http://models:8000
SOLAR_POSITION_API_URL=http://models:8000

# Model 2 — Energy Optimization API (Docker Compose service name)
ENERGY_OPTIMIZATION_SERVICE_URL=http://energy-optimization:8000
ENERGY_OPTIMIZATION_API_URL=http://energy-optimization:8000

MODEL_SERVICE_TIMEOUT=120

# Dashboard API base URL (browser access from host machine)
NEXT_PUBLIC_API_URL=http://localhost:8000
