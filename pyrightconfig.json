{
  "include": ["backend/app"],
  "exclude": ["**/__pycache__", "**/.venv", "**/node_modules"],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": ["backend"],
      "pythonVersion": "3.11",
      "venv": ".venv",
      "venvPath": "backend"
    }
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false
}
