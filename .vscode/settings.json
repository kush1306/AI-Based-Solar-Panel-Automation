{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.languageServer": "None",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.autoComplete.extraPaths": ["${workspaceFolder}/backend"],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.useLibraryCodeForTypes": true,
  "python.analysis.indexing": true,
  "python.terminal.activateEnv": true,
  "python.envFile": "${workspaceFolder}/backend/.env",
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}/backend"
  },
  "basedpyright.analysis.venvPath": "backend",
  "basedpyright.analysis.venv": ".venv",
  "basedpyright.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "basedpyright.analysis.typeCheckingMode": "basic",
  "basedpyright.analysis.diagnosticMode": "workspace",
  "pyright.disableLanguageServices": true,
  "pydev.lint.enabled": false,
  "pydev.lint.ignoreImportErrors": true,
  "pydev.workspace.sourceFolders": ["${workspaceFolder}/backend"],
  "pydev.python.defaultInterpreter": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.linting.enabled": false,
  "python.linting.pylintEnabled": false,
  "problems.showCurrentInStatus": true,
  "cSpell.enabled": true,
  "cSpell.ignorePaths": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/Temp/**"
  ],
  "cSpell.words": [
    "autoflush",
    "sessionmaker",
    "sqlalchemy",
    "pymysql",
    "uvicorn",
    "fastapi",
    "pydantic",
    "starlette",
    "PYTHONPATH",
    "pydev",
    "Pylance",
    "basedpyright"
  ]
}
