# Copy to backend/.env and fill in your values (never commit .env)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=solar_panel_automation
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Optional — add the backend folder to Python path for IDE import resolution
# Example: set PYTHONPATH to the backend directory root

APP_NAME=Solar Intelligence Platform API
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# Model 1 — Solar Position API (Docker Compose service name)
MODEL1_SERVICE_URL=http://models:8000
# Backward-compatible aliases also supported:
# MODEL_SERVICE_URL=http://models:8000
# SOLAR_POSITION_API_URL=http://models:8000

# Model 2 — Energy Optimization API (Docker Compose service name)
ENERGY_OPTIMIZATION_SERVICE_URL=http://energy-optimization:8000
# Backward-compatible alias also supported:
# ENERGY_OPTIMIZATION_API_URL=http://energy-optimization:8000

MODEL_SERVICE_TIMEOUT=120
